
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "test audio_handler",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/transcript/transcript_service.py",
            "args": [
                "-i", "transcript/tests/test_data/me_at_the_zoo.mp3",
                "-l", "DEBUG"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "LECTURE AUDIO HANDLER",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/transcript/transcript_service.py",
            "args": [
                "-i", "lecture_recordings/29_10_25_TRANSFORMER.mp3",
                "-l", "DEBUG"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run RAG",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/rag/rag_service.py",
            "args": [
                "-i", "Make me a summary of the lecture that talks about transformers.",
                "-l", "INFO"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}